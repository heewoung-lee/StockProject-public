{
  "name": "stockbot-electron-dashboard",
  "version": "0.1.0",
  "description": "개미親주식 자동매매 데스크톱 대시보드",
  "author": "heewoung-lee",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "electron": "electron .",
    "test": "vitest run",
    "verify:dependencies": "npm ls --depth=0 && node scripts/verify-dependencies.cjs",
    "build:windows-service": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ../../tools/build_windows_service.ps1",
    "prepare:package": "node scripts/prepare-package.cjs",
    "test:e2e": "npm run verify:dependencies && npm run build && node --test e2e/electron-smoke.cjs",
    "test:e2e:packaged": "node scripts/run-packaged-smoke.cjs",
    "verify:package:win": "npm run package:win:dir && npm run test:e2e:packaged",
    "package:win": "npm run build:windows-service && npm run prepare:package && npm run verify:dependencies && npm run build && electron-builder --win nsis --x64",
    "package:win:dir": "npm run build:windows-service && npm run prepare:package && npm run verify:dependencies && npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.0.0",
    "playwright-core": "1.62.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.heewoung.stockbot",
    "productName": "개미親주식",
    "executableName": "StockBot",
    "electronVersion": "43.2.0",
    "artifactName": "StockBot-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "afterPack": "scripts/write-service-bundle-manifest.cjs",
    "afterSign": "scripts/write-service-bundle-manifest.cjs",
    "directories": {
      "output": "../../dist/electron-dashboard"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/StockBotService",
        "to": "stockbot-service/bundle"
      },
      {
        "from": "../../config.live.example.yaml",
        "to": "stockbot-service/config.live.example.yaml"
      },
      {
        "from": "../../tools/install_stockbot_service.ps1",
        "to": "stockbot-service/installer/install_stockbot_service.ps1"
      },
      {
        "from": "../../tools/install_stockbot_packaged_service.ps1",
        "to": "stockbot-service/installer/install_stockbot_packaged_service.ps1"
      },
      {
        "from": "../../tools/uninstall_stockbot_service.ps1",
        "to": "stockbot-service/installer/uninstall_stockbot_service.ps1"
      },
      {
        "from": "../../tools/stockbot_service_installer_helpers.psm1",
        "to": "stockbot-service/installer/stockbot_service_installer_helpers.psm1"
      }
    ],
    "win": {
      "icon": "public/stockbot-donghak-ant-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "개미親주식"
    }
  }
}
