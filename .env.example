# KIS VTS read-only smoke settings.
# Copy this file to .env and fill values locally. Never commit .env.
# VTS smoke commands only issue a token and read price/balance. They do not place orders.
KIS_VTS_APP_KEY=
KIS_VTS_APP_SECRET=
KIS_VTS_ACCOUNT_NO=
KIS_VTS_ACCOUNT_PRODUCT_CODE=01

# KIS live account values must stay separate from VTS values.
# The live probe is read-only. Live order placement still requires config.live.example.yaml,
# local approval values, current session approval, market-hours checks, audit logging,
# pending-order reconciliation, and per-order preflight.
# KIS_LIVE_APP_KEY=
# KIS_LIVE_APP_SECRET=
# KIS_LIVE_ACCOUNT_NO=
# KIS_LIVE_ACCOUNT_PRODUCT_CODE=01
# STOCKBOT_ALLOW_LIVE_TRADING=true
# STOCKBOT_LIVE_TRADING_ENABLED=true
# STOCKBOT_LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY_TRADING_RISK
# STOCKBOT_LIVE_ACCOUNT_CONFIRMATION=<live-account-last-2-digits>
